{
	"compilerOptions": {
		"incremental": true,
		"strict": true,
		"target": "es2023",
		"module": "esnext",
		"lib": ["ES2023"],
		"sourceMap": false,
		"moduleResolution": "bundler",
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noUncheckedIndexedAccess": true,
		"composite": true,
		"skipLibCheck": true,
		"typeRoots": ["./node_modules/@types"],
		"types": []
	}
}
